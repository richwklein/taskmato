{
  "name": "taskmato-site",
  "private": true,
  "description": "Taskmato marketing site — GitHub Pages",
  "version": "0.10.1",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "upgrade:astro": "npx @astrojs/upgrade",
    "upgrade:tailwind": "npx @tailwindcss/upgrade",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{js,mjs,cjs,ts,astro}\"",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run build",
    "clean": "rm -rf .astro dist node_modules coverage"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.1.14",
    "astro": "^7.1.6",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.18"
  }
}
