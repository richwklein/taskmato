---
import Footer from '@components/Footer.astro'
import Base from '@layouts/Base.astro'
import { NOT_FOUND_DESCRIPTION, NOT_FOUND_TITLE, withBase } from '@utils/site'

const iconSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon.png`
---

<Base title={NOT_FOUND_TITLE} description={NOT_FOUND_DESCRIPTION}>
  <main class="flex min-h-[70vh] flex-col items-center justify-center gap-4 px-6 text-center">
    <img src={iconSrc} alt="Taskmato icon" width="160" height="160" />
    <h1 class="text-ink text-4xl font-bold">Page not found</h1>
    <p class="text-ink-muted max-w-md text-lg">That focus session wandered off.</p>
    <nav aria-label="Suggested pages" class="mt-2 flex flex-wrap items-center justify-center gap-4">
      <a
        href={withBase('/')}
        class="rounded-card bg-brand-ink hover:bg-brand-hover px-6 py-3 font-semibold text-white transition"
      >
        Back to Taskmato
      </a>
      <a href={withBase('/support')} class="text-ink-muted hover:text-ink text-sm underline"
        >Support</a
      >
    </nav>
  </main>
  <Footer />
</Base>
