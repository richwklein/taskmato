---
import Footer from '@components/Footer.astro'
import Base from '@layouts/Base.astro'

interface Props {
  title: string
  description?: string
  heading: string
  updated?: string
  /** The route this page renders, used to mark the active header nav link. */
  current?: 'home' | 'privacy' | 'support' | null
}

const { title, description, heading, updated, current = null } = Astro.props
---

<Base title={title} description={description} current={current}>
  <main class="mx-auto max-w-[740px] px-6 py-16">
    <h1 class="text-ink text-3xl font-bold">{heading}</h1>
    {updated && <p class="text-ink-muted mt-2 text-sm">Last updated: {updated}</p>}
    <div class="prose mt-8 max-w-none">
      <slot />
    </div>
  </main>
  <Footer />
</Base>
