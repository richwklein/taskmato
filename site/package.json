{
  "name": "taskmato-site",
  "private": true,
  "description": "Taskmato marketing site — GitHub Pages",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "upgrade:astro": "npx @astrojs/upgrade",
    "upgrade:tailwind": "npx @tailwindcss/upgrade",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{js,mjs,cjs,ts,astro}\"",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run build",
    "clean": "rm -rf .astro dist node_modules coverage"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
