---
import { REPO_URL, withBase } from '@utils/site'

const year = new Date().getFullYear()
---

<footer class="border-t border-gray-200 px-6 py-8 text-sm text-gray-500">
  <nav aria-label="Footer" class="flex flex-wrap justify-center gap-4">
    <a href={withBase('/')} class="hover:text-gray-700">Home</a>
    <a href={withBase('/privacy')} class="hover:text-gray-700">Privacy</a>
    <a href={withBase('/support')} class="hover:text-gray-700">Support</a>
    <a href={REPO_URL} class="hover:text-gray-700">GitHub</a>
  </nav>
  <p class="mt-4 text-center">&copy; {year} Richard Klein</p>
</footer>
