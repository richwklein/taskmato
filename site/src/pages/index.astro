---
import Footer from '@components/Footer.astro'
import Base from '@layouts/Base.astro'
import { DOWNLOAD_URL, REPO_URL, TAGLINE } from '@utils/site'

const iconSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon.png`
---

<Base title="Taskmato" description={TAGLINE}>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
    <img src={iconSrc} alt="Taskmato icon" width="128" height="128" />
    <h1 class="text-4xl font-bold">Taskmato</h1>
    <p class="max-w-md text-lg text-gray-600">{TAGLINE}</p>
    <a
      href={DOWNLOAD_URL}
      download
      class="rounded-full bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700"
    >
      Download for macOS
    </a>
    <a href={REPO_URL} class="text-sm text-gray-500 underline hover:text-gray-700">View on GitHub</a
    >
  </main>
  <Footer />
</Base>
