# Astro's image service loads `sharp` from a chunk it bundles into `dist/`, so the
# dynamic import resolves against this directory rather than Astro's own
# node_modules. sharp arrives transitively as an optionalDependency of astro, but
# pnpm's strict layout does not link it here — hoisting it fixes the build without
# declaring a second copy in package.json that would then need its own version bump.
public-hoist-pattern[]=sharp
public-hoist-pattern[]=@img/*
