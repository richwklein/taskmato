---
import Footer from '@components/Footer.astro'
import Base from '@layouts/Base.astro'
import { REPO_URL, withBase } from '@utils/site'
---

<Base title="Page not found — Taskmato" description="This page doesn't exist.">
  <main class="flex min-h-[70vh] flex-col items-center justify-center gap-4 px-6 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="max-w-md text-lg text-gray-600">
      The page you're looking for doesn't exist or has moved.
    </p>
    <nav aria-label="Suggested pages" class="flex flex-wrap justify-center gap-4 text-sm">
      <a href={withBase('/')} class="underline hover:text-gray-700">Home</a>
      <a href={withBase('/privacy')} class="underline hover:text-gray-700">Privacy</a>
      <a href={withBase('/support')} class="underline hover:text-gray-700">Support</a>
      <a href={REPO_URL} class="underline hover:text-gray-700">GitHub</a>
    </nav>
  </main>
  <Footer />
</Base>
