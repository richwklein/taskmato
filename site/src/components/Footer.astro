---
import { REPO_URL, withBase } from '@utils/site'

const year = new Date().getFullYear()

const iconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon.png`
---

<footer class="border-line mt-8 border-t">
  <div
    class="text-ink-muted mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-8 text-sm md:flex-row md:justify-between"
  >
    <a href={withBase('/')} class="text-ink flex items-center gap-2.5 font-semibold">
      <img src={iconHref} alt="" width="28" height="28" />
      <span>Taskmato</span>
    </a>
    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-5">
      <a href={withBase('/')} class="hover:text-ink">Home</a>
      <a href={withBase('/privacy')} class="hover:text-ink">Privacy</a>
      <a href={withBase('/support')} class="hover:text-ink">Support</a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-ink"
        >GitHub<span class="sr-only"> (opens in a new tab)</span></a
      >
    </nav>
    <p>&copy; {year} Richard Klein</p>
  </div>
</footer>
